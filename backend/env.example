NODE_ENV="development"
PORT=3000

# ---------- Banco (PostgreSQL) ----------
DB_USER=safeplay
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safeplay
# Fora do Docker. No docker-compose o host é sobrescrito para "db".
# Com Neon (nuvem): cole a connection string DIRETA (sem "-pooler"), com ?sslmode=require
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ---------- Mensageria (RabbitMQ) ----------
RABBITMQ_USER=safeplay
RABBITMQ_PASSWORD=troque-esta-senha
# Fora do Docker. No docker-compose o host é sobrescrito para "rabbitmq".
# Com CloudAMQP (nuvem): cole a AMQP URL do painel (amqps://usuario:senha@host/vhost)
RABBITMQ_URL=amqp://safeplay:troque-esta-senha@localhost:5672
# Nº de denúncias que faz o worker ocultar uma análise
REPORT_THRESHOLD=3
# Espera antes de devolver para a fila uma mensagem que falhou (ms)
WORKER_RETRY_DELAY_MS=5000

# ---------- Autenticação (JWT) ----------
SECRET_KEY=gere-um-valor-aleatorio-longo
EMAIL_TOKEN=gere-outro-valor-aleatorio-longo

# ---------- URLs ----------
BASE_URL=http://localhost:3000
BASE_URL_FRONT=http://localhost:5173
URL_FRONT_HOME=http://localhost:5173/home

# ---------- APIs externas ----------
# https://rawg.io/apidocs
KAY_RAWG=sua-chave-da-rawg
# Token de TESTE do Mercado Pago (credenciais de teste)
MP_ACESS_TOKEN=TEST-seu-token-de-teste

# ---------- E-mail ----------
# console = não envia; mostra destinatário, assunto e links (ex.: verificação) no terminal
# smtp    = envia pelo servidor abaixo
MAIL_DRIVER=console
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=senha
MAIL_FROM="SafePlay <nao-responda@exemplo.com>"

# ---------- Contas da demonstração (npm run seed:demo) ----------
DEMO_ADMIN_EMAIL=admin@safeplay.demo
DEMO_ADMIN_PASSWORD=escolha-uma-senha-com-8+-caracteres
DEMO_USER_EMAIL=jogador@safeplay.demo
DEMO_USER_PASSWORD=escolha-uma-senha-com-8+-caracteres
# Jogo onde ficam as análises de demonstração (id da RAWG; 3498 = GTA V)
DEMO_GAME_ID=3498
